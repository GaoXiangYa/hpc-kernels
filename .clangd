CompileFlags:
  Add:     # 要额外添加的 Clang CUDA 参数
    - --no-cuda-version-check
    - -nocudalib
    # 兼容当前 build/ 目录；重新 configure 后 compile_commands.json 会直接带 -I
    - -I../../../../src/cuda/common
  Remove:  # 移除 Clang/nvcc 之间不兼容的参数
    - -forward-unknown-to-host-compiler
    - --expt-*
    - --generate-code=*
    - -gencode
    - -gencode=*
    - arch=compute_*
    - -arch=*
    - -rdc=*
    - -Xcudafe
    - --diag_suppress=*
    - --options-file
